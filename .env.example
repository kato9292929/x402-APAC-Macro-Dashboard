# --- Data sources ---
NANSEN_API_KEY=
ANTHROPIC_API_KEY=
ESTAT_API_KEY=
# Optional: base URL for the Japan Data API (rates / FX / real estate feed).
# When unset, the dashboard falls back to a curated representative dataset.
JAPAN_DATA_API_URL=

# --- Payment wallets ---
WALLET_ADDRESS=                  # EVM receiving wallet (Base / Polygon / BNB)
SOLANA_WALLET_ADDRESS=           # Solana receiving wallet (base58)

# --- x402 facilitator ---
FACILITATOR_URL=https://api.developer.coinbase.com/rpc/v1/base/facilitator
# Polygon-capable facilitator. Falls back to FACILITATOR_URL when unset, but
# the Base CDP facilitator does not settle Polygon — set this in production.
POLYGON_FACILITATOR_URL=

# --- RPC endpoints ---
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
BNB_RPC_URL=https://bsc-dataseed.binance.org/

# --- Wallet / token contracts ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
NEXT_PUBLIC_JPYC_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BDB
NEXT_PUBLIC_USDT_BNB_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# JPYC EIP-712 domain — verify against the deployed JPYC contract.
JPYC_EIP712_NAME=JPYC
JPYC_EIP712_VERSION=1

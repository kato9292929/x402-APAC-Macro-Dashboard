# --- Data sources ---
NANSEN_API_KEY=
ANTHROPIC_API_KEY=
ESTAT_API_KEY=
# Optional: base URL for the Japan Data API (rates / FX / real estate feed).
# When unset, the dashboard falls back to a curated representative dataset.
JAPAN_DATA_API_URL=

# --- Payment wallets ---
WALLET_ADDRESS=0xC67d94504696960bA0f2e7C3FeE703950734c00A   # EVM receiving wallet (Base / Polygon / BNB)
SOLANA_WALLET_ADDRESS=                                       # Solana receiving wallet (base58)

# --- x402 v2 facilitator ---
# Coinbase Developer Platform (CDP) API keys for the production v2 facilitator.
# When both are set, the app authenticates with the CDP facilitator at
# FACILITATOR_URL (gas sponsorship, mainnet SLA, 1k tx/mo free then $0.001/tx).
# Leave both empty to fall back to FACILITATOR_URL with no auth, or to the
# package default when FACILITATOR_URL is also unset.
CDP_API_KEY_ID=        # UUID format (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
CDP_API_KEY_SECRET=    # base64 (often ends with ==)
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# --- RPC endpoints ---
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
BNB_RPC_URL=https://bsc-dataseed.binance.org/

# --- Wallet / token contracts ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
NEXT_PUBLIC_USDT_BNB_CONTRACT=0x55d398326f99059fF775485246999027B3197955
